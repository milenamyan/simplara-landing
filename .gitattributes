# Normalize line endings: store text files with LF in the repository
* text=auto eol=lf

# Explicitly treat common source/text files as text (LF in repo)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gs text eol=lf

# Binary files: never modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
